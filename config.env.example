# Copy to config.env (gitignored) and fill in. Every value is public material:
# project IDs, resource names and principal emails. No secrets belong here.
#
# CI has no config.env. It takes the same variables from GitHub Actions
# repository variables (see README, "Enable the weekly check").

# GCP project that holds the key ring and the key, and nothing else.
KEY_PROJECT=

# GCP project that holds the keeper runtime (part three). It receives exactly
# one cross-project grant: roles/cloudkms.signer on the key, to KEEPER_SA.
KEEPER_PROJECT=

# KMS location. Multi-region "us" by default; see README for why.
LOCATION=us

# Key ring and key names inside KEY_PROJECT. The address is the property of
# version 1 of this key. This repo never creates a second version.
KEY_RING=hydrex-keeper
KEY=keeper

# Google group whose members administer the key (roles/cloudkms.admin on the
# key). Two or three humans, hardware 2FA enforced. Nothing in CI is a member.
ADMIN_GROUP=

# Service account of the Cloud Run job in KEEPER_PROJECT. Leave empty until
# part three has created it, then fill it in and run sh/grant.sh. Once set,
# sh/setup.sh and sh/check.sh include it in the expected key policy.
# Must end in @${KEEPER_PROJECT}.iam.gserviceaccount.com.
KEEPER_SA=
