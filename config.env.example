# Copy to config.env (gitignored). Public material only.

# Project holding the key ring and key, nothing else.
KEY_PROJECT=

# Project holding the keeper runtime (part three).
KEEPER_PROJECT=

# KMS location. See README.
LOCATION=us

KEY_RING=hydrex-keeper
KEY=keeper

# Google group with roles/cloudkms.admin on the key. Hardware 2FA. No CI members.
ADMIN_GROUP=

# Cloud Run job service account, @${KEEPER_PROJECT}.iam.gserviceaccount.com.
# Empty until part three exists; then set it and run sh/grant.sh.
KEEPER_SA=
