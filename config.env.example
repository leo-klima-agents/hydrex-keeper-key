# Copy to config.env (gitignored). Public material only.

# Project holding the key ring and key, nothing else.
KEY_PROJECT=

# Project holding the keeper service (a Cloud Run job).
KEEPER_PROJECT=

# KMS location. See README.
LOCATION=us

KEY_RING=hydrex-keeper
KEY=hydrex-keeper-v1

# Principal with roles/cloudkms.admin on the key: user:EMAIL or group:EMAIL.
# Humans only, hardware 2FA.
ADMIN_MEMBER=

# Service account (SA) of the Cloud Run job, @${KEEPER_PROJECT}.iam.gserviceaccount.com.
# Empty until that account exists; then set it and run sh/grant.sh.
KEEPER_SA=
