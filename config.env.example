# Copy to config.env. Public material only.

# Project for the key ring and the keys only; it must differ from KEEPER_PROJECT.
KEY_PROJECT=

# Project of the keeper, the Cloud Run job that signs with the keys.
KEEPER_PROJECT=

# KMS location of the key ring. Choose once: it is part of the key's name, and so of the record.
LOCATION=us

KEY_RING=hydrex-keeper

# The key that signs the weekly vote; its address is the KEEPER of hydrex-conduit-executor's module.
KEEPER_KEY=hydrex-keeper-v1

# The key that signs the immutable conduit's votes for hydrex-keeper, for example hydrex-proposer-v1; empty for none.
PROPOSER_KEY=

# Who administers the key: user:EMAIL or group:EMAIL, with hardware 2FA.
ADMIN_MEMBER=

# The keeper's service account, printed by hydrex-keeper's sh/setup.sh. Empty until it exists; then run sh/grant.sh.
KEEPER_SA=

# Receives an email when anything under the key ring changes: a key, a version or an IAM policy.
ALERT_EMAIL=
